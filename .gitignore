# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo
partner/agent/bin/

# env & secrets  (§82: no hard-coded credentials)
.env
.env.*
!.env.example
# The production TEMPLATE, which carries no values -- every secret in it is
# blank. It has to be tracked: four documents tell an operator to run
# `cp .env.prod.example .env.prod` as the first step of a deployment, and
# `.env.*` above had been quietly swallowing it, so on a fresh clone that
# command failed with "No such file or directory" at step one.
# The real file, .env.prod, stays ignored by the rule above.
!.env.prod.example
*.pem
*.key
!**/testdata/*.key

# Locally generated signing keys (§75 manifests, §92.3 Agent tokens).
# These are PRIVATE ES256 keys: anyone holding the manifest key can forge an
# activation manifest that a Partner Agent will accept as genuine. They are
# generated on first boot and belong in a secret manager everywhere else.
.keys/
*.keyfile.json
oolix/apps/api-gateway/test/.keys-test/
partner/agent/config.local.yaml
partner/agent/.agent-state/

# local data
/var/
tmp/
coverage/
.playwright/
test-results/
playwright-report/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# generated
oolix/apps/api-gateway/src/generated/

# Production compose environment — secrets, never committed.
.env.prod

# Pack-verification scratch config (contains a local test DSN)
packtest-agent.yaml

# Local backup destination used when rehearsing the production stack.
# These are real database dumps and signing-key archives — never commit them.
oolix/infra/docker/backups/
