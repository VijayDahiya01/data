# Environment for oolix/infra/docker/compose.prod.yml
#
# Copy to .env.prod and fill in every value marked REQUIRED. Those have no
# default: the compose file refuses to start without them rather than falling
# back to something that looks like it works.
#
# .env.prod is gitignored. Nothing here belongs in version control.
#
# The defaults below describe a REAL DEPLOYMENT on a real domain, because that
# is what this file is copied for. To rehearse the stack on a laptop instead,
# see "Local HTTPS rehearsal" at the bottom -- it lists the four values to
# change back and nothing else.
#
# Run `pnpm preflight --env-file .env.prod` before deploying. It refuses every
# mistake this file can still contain.
#
# ── A WARNING ABOUT COMMENTS ────────────────────────────────────────────────
# Docker Compose does NOT strip a trailing comment from a value. Writing
#
#     POSTGRES_PASSWORD=          # REQUIRED
#
# sets the password to the literal string "# REQUIRED" — non-empty, so nothing
# complains, and the database connection then fails somewhere far from here.
# Every comment in this file is therefore on its own line.

# Load-bearing, not a label. The exact string "production" — and nothing else —
# switches on Content-Security-Policy and HSTS (bootstrap.ts) and the §4.2 MFA
# requirement for PARTNER_ADMIN, PARTNER_SECURITY_ADMIN,
# PARTNER_CAMPAIGN_APPROVER, FINANCE, BUYER_ADMIN and OOLIX_ADMIN
# (auth.guard.ts). "staging" serves a public deployment with all three off
# while every other check still passes green. preflight refuses anything else.
APP_ENV=production

# REQUIRED. An IMMUTABLE tag — a commit SHA or a build number. `latest` and
# `dev` move, so rolling back to one rolls back to nothing, and nobody
# discovers that until the moment they need it.
IMAGE_TAG=

# --- managed services ---------------------------------------------------------
#
# Required by oolix/infra/docker/compose.managed.yml, which removes the bundled
# Postgres and Redis. Without that overlay you run databases on the host, which
# works and gives up the backups, failover and patching you are paying for.
#
# KEYCLOAK_JDBC_URL is a JDBC string and DATABASE_URL is not. Handing Keycloak
# the postgres:// form fails at start-up with a driver error that never
# mentions the format — the single most common way this deployment goes wrong.
#
# Managed providers commonly use a non-standard port (DigitalOcean: 25060, not
# 5432) and require sslmode=require. Redis over TLS is rediss://, two s's.
DATABASE_URL=
KEYCLOAK_JDBC_URL=
REDIS_URL=

# Keycloak's database credentials, separately. A JDBC URL carries no user or
# password, so these cannot be folded into KEYCLOAK_JDBC_URL the way they are
# in DATABASE_URL. With one managed instance they are usually the same
# credentials as POSTGRES_USER / POSTGRES_PASSWORD, pointed at the `keycloak`
# database rather than the application's.
# REQUIRED
KEYCLOAK_DB_USER=
# REQUIRED
KEYCLOAK_DB_PASSWORD=

# --- bundled database ---------------------------------------------------------
#
# Used only WITHOUT the managed overlay. With managed services, set
# POSTGRES_USER and POSTGRES_PASSWORD to the managed credentials anyway — the
# backup service connects with them over the network.
POSTGRES_USER=oolix
# REQUIRED
POSTGRES_PASSWORD=
POSTGRES_DB=oolix
KEYCLOAK_DB=keycloak

# --- identity -----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
# REQUIRED
KEYCLOAK_ADMIN_PASSWORD=

OIDC_CLIENT_ID=oolix-web
# REQUIRED. Generate it -- `openssl rand -base64 32` -- and use the SAME value
# here and nowhere else.
#
# This one value is written into Keycloak's realm at import AND used by the
# portal to authenticate against it. They must match. It used to be a literal
# inside oolix/infra/keycloak/oolix-realm.json, which meant the repository published
# the production secret; setting a strong one here without changing that file
# broke sign-in with a mismatch instead. It is now substituted at render time.
OIDC_CLIENT_SECRET=

# --- Keycloak hardening --------------------------------------------------------
#
# Each of these defaults to the safe value, so leaving them as they are is
# correct. They exist because the local development realm needs the opposite of
# each, and a single realm file has to serve both.
#
# external: Keycloak tolerates the TLS terminator's plain HTTP hop but refuses
# an external request that is not HTTPS.
KC_SSL_REQUIRED=external
# The password grant. false in production: it bypasses the browser sign-in
# entirely, and with it the step-up authentication the realm now performs. The
# local verify scripts need it on, which is the only reason it is configurable.
KC_DIRECT_GRANTS=false
# Never true on a deployment. It would seed thirteen development identities
# with the password `password`, one of which holds OOLIX_ADMIN plus every
# Partner role. render-realm.mjs refuses it outright when TLS is required, and
# preflight refuses it here first.
KC_SEED_USERS=false
# §66 hands these accounts to real people at a real Partner.
KC_PASSWORD_POLICY=length(12) and notUsername and upperCase(1) and lowerCase(1) and digits(1)

# Note: the realm requires a second factor of EVERY account (§4.2, §82).
# Keycloak cannot know which Oolix role an account will hold, so it is
# all-or-nothing and the safe direction is on. Each person enrols an
# authenticator app at first sign-in; budget a minute each. Verify it works
# with `pnpm verify:mfa` after deploying — the failure it catches is invisible
# from outside, because sign-in succeeds and only the API calls fail.

# --- TLS and public addresses ---------------------------------------------------
#
# These have to agree. The Agent verifies manifest signatures against an issuer
# and audience, the API validates tokens against an issuer, and the portal's
# cookies are marked Secure only when WEB_PUBLIC_URL is https. Change one
# without the others and authentication fails in a way that does not name the
# cause.
#
# An OIDC issuer is compared as a STRING. If the browser reaches Keycloak by
# one name and the portal's server side by another, every token is rejected as
# invalid while everything looks correct.
#
# TLS_MODE: an EMAIL address, which switches Caddy to real Let's Encrypt
# certificates for the hosts below. They must resolve publicly and reach ports
# 80 and 443. The literal "internal" issues from a local CA that browsers
# distrust and Partner Agents refuse; preflight rejects it.
# REQUIRED
TLS_MODE=

# The hostnames Caddy answers on. Three A records on one domain.
# REQUIRED
API_HOST=
APP_HOST=
AUTH_HOST=

# The same three names as https:// URLs. They must match exactly.
# REQUIRED
API_PUBLIC_URL=
WEB_PUBLIC_URL=
KEYCLOAK_PUBLIC_URL=

# --- portal ---------------------------------------------------------------------
# REQUIRED. At least 32 characters. Rotating it signs everyone out, which is
# the intended behaviour rather than a side effect.
PORTAL_SESSION_SECRET=

# --- object storage ---------------------------------------------------------------
#
# Creative assets. Any S3-compatible bucket; AWS_ENDPOINT_URL is what points the
# client at a non-AWS one (DigitalOcean Spaces, MinIO, Cloudflare R2).
#
# The region is a COMPLIANCE decision, not a latency one. The spec prices in INR
# and targets IN geographies; if real Indian customers are involved, the DPDP
# Act 2023 governs where data physically sits. Choose before provisioning —
# moving a bucket or a database between regions later is a migration.
AWS_REGION=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_CREATIVE_BUCKET=
CDN_PUBLIC_BASE_URL=

# --- optional ---------------------------------------------------------------------
# Leave empty to run the worker with schedulers only. Queue-lag alerting has
# nothing to measure until this is set, which is a valid deployment.
SQS_DOMAIN_EVENTS_URL=

# --- external channels --------------------------------------------------------------
#
# Meta and Google activation. Off by default and §84 keeps the channel
# unrequestable while they are. Turning either on needs platform credentials
# that take weeks (Meta App Review, Google Data Manager access) AND a privacy
# review, because this is the one path on which customer data leaves the
# Partner boundary. A first pilot on owned media needs neither.
FEATURE_META_ENABLED=false
FEATURE_GOOGLE_ENABLED=false

# --- secrets from files rather than the environment ---------------------------------
#
# Any variable above can instead be supplied as a file, which is how Docker
# secrets, Kubernetes secret volumes and the managed secret-store sidecars all
# work. Append _FILE and give a path:
#
#     POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
#
# The application reads it at start-up and removes the pointer, so the secret
# never appears in the environment — where `docker inspect`, /proc/1/environ,
# a crash reporter and every child process would otherwise all see it.
#
# Setting both a variable and its _FILE form to different values is refused
# rather than resolved by a precedence rule nobody remembers.

# --- Backups -----------------------------------------------------------------------
#
# REQUIRED. Where scheduled backups are written, and it MUST leave this host:
# an NFS mount, an object-storage gateway, anything that is not this disk. A
# backup beside the database survives only the failures that do not matter.
#
# The stack runs these on a schedule by itself -- see the `backup` service.
# It captures both databases AND the signing keys; a database restore without
# the manifest key leaves every Agent rejecting every manifest it holds, and
# nothing reports the cause.
BACKUP_DEST=
# How often, and how many to keep on the mount. Retention beyond this belongs
# to whatever owns the destination.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7

# --- Alert routing -------------------------------------------------------------------
#
# REQUIRED if you run the `monitoring` profile, and you should.
#
# These used to be literals inside oolix/infra/monitoring/alertmanager.yml with a
# comment asking somebody to change them -- the most forgettable kind of step,
# because every other setting is here. They are substituted at deploy time and
# the renderer REFUSES a placeholder, so a stack that would fire every alert
# into a hostname that does not resolve fails at start-up instead.
#
# Not localhost: inside a container that is Alertmanager itself.
ALERT_WEBHOOK_DEFAULT=
ALERT_WEBHOOK_ONCALL=

# --- Local HTTPS rehearsal -------------------------------------------------------------
#
# To run this stack on a laptop instead of a host — proving it works over HTTPS
# without owning a domain — change exactly these, and nothing else:
#
#     APP_ENV=staging
#     TLS_MODE=internal
#     API_HOST=api.oolix.localhost
#     APP_HOST=app.oolix.localhost
#     AUTH_HOST=auth.oolix.localhost
#     API_PUBLIC_URL=https://api.oolix.localhost
#     WEB_PUBLIC_URL=https://app.oolix.localhost
#     KEYCLOAK_PUBLIC_URL=https://auth.oolix.localhost
#     BACKUP_DEST=./backups
#
# and add to your hosts file:
#
#     127.0.0.1  api.oolix.localhost app.oolix.localhost auth.oolix.localhost
#
# `pnpm preflight` will then report these as failures. That is correct and
# expected for a rehearsal — it is refusing to let a laptop configuration reach
# a real Partner. Never deploy a file that still has them.
