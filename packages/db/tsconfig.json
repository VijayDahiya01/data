{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "isolatedModules": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // The Prisma-generated client is large and already carries @ts-nocheck;
    // these keep the build fast and quiet without weakening our own sources,
    // which are typechecked by the apps that import them.
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"]
}
