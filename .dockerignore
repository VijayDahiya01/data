# Keep the build context small and free of anything that must not reach an
# image. A large context is slow to send to the daemon on every build; a
# context carrying secrets is worse than slow.

# Dependencies and build output are produced inside the image, never copied in.
node_modules
**/node_modules
dist
**/dist
.next
**/.next
**/src/generated

# Local state and secrets. `.env` in particular must never be baked into a
# layer: production configuration comes from the orchestrator's environment.
.env
.env.*
!.env.example
# Local signing keys. No Dockerfile copies them today; this keeps them out of
# the build context too, so a later broad COPY cannot pick them up.
.keys
**/.keys
partner/agent/.agent-state
partner/agent/config.local.yaml
partner/agent/bin

# Test and tooling output.
test-results
playwright-report
screenshots
coverage
*.log

# Version control and editor noise.
.git
.github
.vscode
.idea

# Documentation and specs are not needed to build a service.
docs
partner/pack
newone-backup-*
