# ==========================================================================
# Oolix - local environment template  (spec v5 §65.1)
# Copy to .env for local development.  NEVER commit a real .env  (§82).
# ==========================================================================

APP_ENV=local
LOG_LEVEL=debug
LOG_FORMAT=json

# --- Oolix Cloud services -------------------------------------------------
API_PORT=4000
WEB_PORT=3000
WORKER_METRICS_PORT=4100
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# --- PostgreSQL 16 (§64) --------------------------------------------------
DATABASE_URL=postgresql://oolix:oolix@localhost:5432/oolix?schema=public
DATABASE_POOL_SIZE=10

# --- Redis 7 (§64) --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Sign-in and email ---------------------------------------------------
# Oolix checks passwords and issues its own sign-in tokens: nothing else to
# run. The signing key is created in ./.keys on first start, like the others.
USER_ACCESS_TOKEN_TTL_SEC=600
USER_SESSION_TTL_HOURS=8
# Refuse breached passwords (Have I Been Pwned, k-anonymity). Allows the
# password when offline, so it is safe to leave on.
PASSWORD_BREACH_CHECK=true
# "log" prints every email -- verification, invitation and reset links
# included -- to the API's terminal instead of sending it. Deployments use
# "brevo" with BREVO_API_KEY; see .env.prod.example.
EMAIL_PROVIDER=log
EMAIL_FROM=Oolix <no-reply@oolix.localhost>

# Seals the portal's session cookie (AES-256-GCM). The cookie holds the user's
# access and refresh tokens, so this is a real secret: rotate it and every
# session ends.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PORTAL_SESSION_SECRET=local-only-portal-session-secret-change-me
# Where the portal reaches the API from the SERVER. The browser never calls the
# API directly, so this may be an internal address in a real deployment.
OOLIX_API_INTERNAL_URL=http://localhost:4000

# --- AWS / LocalStack (§64) ----------------------------------------------
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_CREATIVE_BUCKET=oolix-creatives-local
CDN_PUBLIC_BASE_URL=http://localhost:4566/oolix-creatives-local
SQS_DOMAIN_EVENTS_URL=http://localhost:4566/000000000000/oolix-domain-events
SQS_DOMAIN_EVENTS_DLQ_URL=http://localhost:4566/000000000000/oolix-domain-events-dlq
SQS_REPORTING_URL=http://localhost:4566/000000000000/oolix-reporting
SQS_REPORTING_DLQ_URL=http://localhost:4566/000000000000/oolix-reporting-dlq

# --- Manifest signing (§75) ----------------------------------------------
# Local dev uses a file-backed ES256 key. Production uses cloud KMS/HSM.
MANIFEST_SIGNING_KEY_ID=local-es256-key-1
MANIFEST_SIGNING_PRIVATE_KEY_PATH=./.keys/manifest-signing-local.pem
MANIFEST_JWKS_PATH=./.keys/manifest-jwks-local.json
MANIFEST_ISSUER=http://localhost:4000
MANIFEST_AUDIENCE=oolix-partner-agent
MANIFEST_CONFIG_TTL_SEC=900

# --- Agent workload auth (§92) -------------------------------------------
AGENT_TOKEN_ISSUER=http://localhost:4000
AGENT_TOKEN_AUDIENCE=oolix-agent-api
AGENT_ACCESS_TOKEN_TTL_SEC=900
AGENT_BOOTSTRAP_TOKEN_TTL_SEC=900

# --- Attribution (§71, §90) ----------------------------------------------
CLICK_TOKEN_TTL_DAYS=7

# --- Catalogue / anti-differencing (§72) ---------------------------------
CATALOG_MIN_REACH=1000
CATALOG_BUCKET_PUBLICATION_INTERVAL_HOURS=24

# --- Partner Agent control sync (§75) ------------------------------------
CONTROL_SYNC_INTERVAL_SEC=30
CONTROL_STALE_GRACE_SEC=900

# --- Approval SLA (§101) -------------------------------------------------
PARTNER_REQUEST_EXPIRY_DAYS=7
PARTNER_REQUEST_EXTENSION_MAX_DAYS=7

# --- Reconciliation tolerance (§77.3) ------------------------------------
RECONCILIATION_MIN_EVENTS=10
RECONCILIATION_PERCENT=0.5

# --- External channels: OFF until eligibility proven (§15, §16, §84) -----
FEATURE_META_ENABLED=false
FEATURE_GOOGLE_ENABLED=false

# --- Mock Partner (§91) --------------------------------------------------
MOCK_PARTNER_PORT=4001
PARTNER_AGENT_URL=http://localhost:8082
