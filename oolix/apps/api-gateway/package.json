{
  "name": "@oolix/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Oolix Cloud control plane. Modular monolith (spec v5 §61) exposing /v1 user APIs and /agent/v1 Partner Agent APIs.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-sqs": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@oolix/auth-rbac": "workspace:*",
    "@oolix/contracts": "workspace:*",
    "@oolix/db": "workspace:*",
    "@oolix/manifest-schema": "workspace:*",
    "@oolix/observability": "workspace:*",
    "@oolix/runtime-config": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "jest": "30.4.2",
    "pg": "8.23.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  }
}
