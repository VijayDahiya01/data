// ===========================================================================
// Oolix central control-plane schema -- spec v5 §73 (canonical), §96 (inline
// critical SQL). §73 supersedes the earlier §20 and §54 field lists.
//
// THE CENTRAL DB EXCLUSION (§54, §73) IS A HARD ARCHITECTURAL RULE:
//   There is no `customers` table.
//   There is no `audience_members` / `segment_members` table.
//   There is no `partner_transactions` or `partner_purchase_history` table.
//   There is no cross-partner identity graph.
//   No column anywhere stores a partner_user_id.
// Customer membership and user-level ad decisions stay inside the Data
// Partner (§3, §12). If a future migration proposes a table keyed by a
// partner's user identifier, it contradicts the product's core claim.
//
// Conventions (§73):
//   - UUID primary keys.
//   - Money = BIGINT minor units + CHAR(3) currency. Never Float/Decimal.
//   - Timestamps are TIMESTAMPTZ, always UTC (§53).
//   - Migrations are expand/contract for zero-downtime.
// ===========================================================================

// Prisma 7: the generated client lives in the repo tree and the connection
// URL moved to prisma.config.ts (see that file). The client connects through
// a driver adapter, configured in src/prisma/prisma.service.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums -- mirror @oolix/contracts. The TypeScript enums in that package and
// these database enums must stay in lockstep; a drift test asserts it.
// ---------------------------------------------------------------------------

