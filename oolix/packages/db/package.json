{
  "name": "@oolix/db",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Oolix control-plane schema, migrations and Prisma client (spec v5 \u00a773, \u00a796).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@oolix/auth-rbac": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "prisma"
  ]
}
