# =============================================================================
# Oolix API gateway — the control plane.
#
# Holds campaigns, Partner approvals, activations and settlement, and signs the
# manifests each Partner Agent pulls. It holds no customer record, which is why
# this image needs no special data handling — but it does hold the manifest
# signing key material at runtime, so it runs unprivileged and ships without a
# package manager or shell tooling to acquire one.
#
# Build from the repository root:
#   docker build -f oolix/infra/docker/Dockerfile.api-gateway -t oolix/api-gateway:dev .
# or let compose do it: `docker compose -f oolix/infra/docker/compose.prod.yml build`
# =============================================================================

# Pinned to the same major the workspace declares (`engines.node >=24.19 <25`).
# A runtime that drifts from the one the code was tested on is a silent risk.
ARG NODE_VERSION=24.19.0-alpine

# -----------------------------------------------------------------------------
# Stage 1 — dependencies
#
# Only the manifests are copied first, so this layer is reused whenever source
# changes but dependencies do not, which is most of the time.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS deps
WORKDIR /repo

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# EVERY workspace manifest, including the Partner side's. This image never runs
# Partner code, but `--frozen-lockfile` refuses unless each importer the
# lockfile names is present, and the lockfile names all of them. Dropping the
# two partner/ lines looks like tidying and breaks the build.
COPY oolix/apps/api-gateway/package.json       oolix/apps/api-gateway/
COPY oolix/apps/web-portal/package.json        oolix/apps/web-portal/
COPY oolix/apps/worker/package.json            oolix/apps/worker/
COPY oolix/packages/auth-rbac/package.json     oolix/packages/auth-rbac/
COPY oolix/packages/db/package.json            oolix/packages/db/
COPY oolix/packages/manifest-schema/package.json oolix/packages/manifest-schema/
COPY oolix/packages/observability/package.json oolix/packages/observability/
COPY oolix/packages/runtime-config/package.json oolix/packages/runtime-config/
COPY shared/contracts/package.json             shared/contracts/
COPY partner/sdk-web/package.json              partner/sdk-web/
COPY partner/mock-partner/package.json         partner/mock-partner/

# `--frozen-lockfile` makes the build fail rather than silently resolve a
# different tree than the one that was tested.
RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 2 — build
# -----------------------------------------------------------------------------
FROM deps AS build
WORKDIR /repo

COPY tsconfig.base.json ./
COPY oolix/packages ./oolix/packages
COPY shared ./shared
COPY oolix/apps/api-gateway ./oolix/apps/api-gateway

# `prisma generate` reads prisma.config.ts, which resolves DATABASE_URL eagerly
# and throws when it is absent. Generation itself never connects to anything —
# the requirement exists so that MIGRATIONS fail loudly rather than run against
# the wrong database, which is worth keeping.
#
# So the build gets a placeholder. It is scoped to this stage, never reaches the
# runtime image, and the real URL is supplied by the orchestrator at start-up.
# If this value ever appears in a connection error, something is reading
# configuration from the wrong place.
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"

# Packages first: the API imports their build output, not their source. This
# also runs `prisma generate`, which the API needs to compile at all.
#
# `^...` selects the API's workspace dependencies and not the API itself --
# the set is derived from package.json rather than spelled as a folder glob.
# It used to be `./packages/*`, which matched nothing once the libraries were
# split across oolix/ and shared/, and a filter matching nothing is not an
# error: pnpm builds zero packages and the failure surfaces later, as the API
# being unable to import a library that was never compiled.
RUN pnpm --filter "@oolix/api-gateway^..." build \
 && pnpm --filter @oolix/api-gateway build

# Resolve the workspace links into a self-contained tree.
#
# `--legacy` is deliberate. pnpm 10's modern deploy refuses without
# `inject-workspace-packages` and then fails against a shared lockfile anyway,
# and copying the pruned workspace by hand produces a LARGER image because the
# virtual store comes along with it.
#
# What legacy mode costs: it copies the whole content-addressable store, so the
# Prisma CLI, Prisma Studio and TypeScript ride along even under `--prod`. That
# is roughly 190MB of build tooling in a runtime image, and it is worth removing
# properly — most likely by bundling the service — rather than by another round
# of packaging flags.
RUN pnpm --filter @oolix/api-gateway deploy --prod --legacy /out

# -----------------------------------------------------------------------------
# Stage 3 — runtime
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS runtime

# dumb-init gives the process a real PID 1, so SIGTERM reaches Node and the
# server can finish in-flight requests instead of being killed mid-response.
RUN apk add --no-cache dumb-init

ENV NODE_ENV=production
WORKDIR /app

# Owned by root and run as `node`: the service writes to stdout and the
# database, never to its own filesystem, so nothing here needs to be writable.
COPY --from=build --chown=root:root /out ./

# Give the Prisma CLI a real name on PATH.
#
# `pnpm deploy --prod` copies the package into the store directory but writes
# no `.bin` entry for it, so `npx prisma` exits 127 -- which is how the
# documented migration step came to be one that had never been run. Resolving
# the hashed store path once, at build time, turns a silent runtime failure
# into a build that fails loudly if the CLI is ever absent.
RUN set -eu; \
    pkg="$(ls -d node_modules/.pnpm/prisma@*/node_modules/prisma | head -1)"; \
    { echo '#!/bin/sh'; echo "exec node \"/app/$pkg/build/index.js\" \"\$@\""; } > /usr/local/bin/prisma; \
    chmod 0755 /usr/local/bin/prisma; \
    prisma --version > /dev/null; \
    ln -sfn "/app/$pkg" node_modules/prisma

# The migration config Prisma 7 requires.
#
# In Prisma 7 the datasource URL lives in a config file rather than in
# schema.prisma, so `migrate deploy` refuses to run without one. The
# developer-facing oolix/packages/db/prisma.config.ts cannot be reused: it pulls
# in dotenv and a tsx-based seed command, none of which exist in a production
# image. This one reads DATABASE_URL and nothing else.
COPY --chown=root:root oolix/infra/docker/prisma.migrate.config.ts ./prisma.config.ts

# Prove the whole migration path resolves at BUILD time, so a broken deployment
# step cannot reach a pilot. `migrate diff` needs no database — it only needs
# the CLI, the config and the schema to load, which is exactly what kept
# breaking.
#
# The placeholder URL is never connected to: `migrate diff` against
# `--from-empty` reads only the schema. It is here because the config resolves
# DATABASE_URL eagerly, the same eager resolution documented above for
# `prisma generate`.
RUN DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build" \
    prisma validate > /dev/null

# The signing-key directory, owned by the user that runs the process.
#
# Docker seeds a new named volume from whatever is at the mount point in the
# image, ownership included. Without this the volume arrives owned by root, the
# unprivileged process cannot write its keys, and the failure appears as a bare
# EACCES during the one-time provisioning step.
RUN mkdir -p /app/.keys && chown node:node /app/.keys

USER node
EXPOSE 4000

# The API's own readiness endpoint, so an orchestrator restarts a process that
# is running but not serving.
# API_PORT, not PORT — that is the variable the service reads. A healthcheck
# probing a port nothing listens on reports a failure that is entirely its own.
HEALTHCHECK --interval=15s --timeout=3s --start-period=25s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||4000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
