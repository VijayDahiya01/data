# =============================================================================
# Oolix portal — the interface for all four personas.
#
# Server-rendered on purpose: a person's access and refresh tokens are held in
# a sealed, httpOnly session cookie that browser code cannot read (§82), so
# this container is a trust boundary rather than a static asset host. It needs
# the session secret at runtime, and it must never be built with it.
#
# Build from the repository root:
#   docker build -f oolix/infra/docker/Dockerfile.web-portal -t oolix/web-portal:dev .
# or let compose do it: `docker compose -f oolix/infra/docker/compose.prod.yml build`
# =============================================================================

ARG NODE_VERSION=24.19.0-alpine

# -----------------------------------------------------------------------------
# Stage 1 — dependencies
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS deps
WORKDIR /repo

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Every workspace manifest, the Partner side's included -- `--frozen-lockfile`
# refuses unless each importer the lockfile names is present. See the API
# gateway image.
COPY oolix/apps/api-gateway/package.json       oolix/apps/api-gateway/
COPY oolix/apps/web-portal/package.json        oolix/apps/web-portal/
COPY oolix/apps/worker/package.json            oolix/apps/worker/
COPY oolix/packages/auth-rbac/package.json     oolix/packages/auth-rbac/
COPY oolix/packages/db/package.json            oolix/packages/db/
COPY oolix/packages/manifest-schema/package.json oolix/packages/manifest-schema/
COPY oolix/packages/observability/package.json oolix/packages/observability/
COPY oolix/packages/runtime-config/package.json oolix/packages/runtime-config/
COPY shared/contracts/package.json             shared/contracts/
COPY partner/sdk-web/package.json              partner/sdk-web/
COPY partner/mock-partner/package.json         partner/mock-partner/

RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 2 — build
# -----------------------------------------------------------------------------
FROM deps AS build
WORKDIR /repo

COPY tsconfig.base.json ./
COPY oolix/packages ./oolix/packages
COPY shared ./shared
COPY oolix/apps/web-portal ./oolix/apps/web-portal

# See the API gateway image for why this placeholder exists: prisma.config.ts
# resolves DATABASE_URL eagerly so that migrations cannot run against the wrong
# database. Generation never connects, and this value never leaves the build.
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"

# The portal reads its configuration at runtime, but `next build` still
# evaluates the config module, which validates the environment. These are
# structural placeholders so the build can complete; every one is replaced by
# the orchestrator at start-up.
ENV APP_ENV=production \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    OOLIX_API_INTERNAL_URL="http://api:4000" \
    API_PUBLIC_URL="http://localhost:4000" \
    WEB_PUBLIC_URL="http://localhost:3000"

# The secret-shaped value is passed to the build command rather than set with
# ENV. ENV persists into the image's metadata, so even a placeholder there
# would model exactly the wrong habit — and Docker flags it, which trains people
# to ignore a warning that should stay meaningful.
#
# `^...` is the portal's workspace dependencies -- today only `contracts`. See
# the API gateway image for why this is not a folder glob.
RUN pnpm --filter "@oolix/web-portal^..." build \
 && PORTAL_SESSION_SECRET=placeholder-replaced-at-runtime \
    pnpm --filter @oolix/web-portal build

# -----------------------------------------------------------------------------
# Stage 3 — runtime
#
# Only the standalone output is copied. It carries the traced dependencies and
# nothing else, so this image needs no node_modules of its own and no package
# manager to install one.
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS runtime

# "No package manager" has to be made true: the base image ships npm, npx,
# corepack and yarn, and npm's bundled dependencies were most of what the image
# scanner reported. They go, and Alpine's security updates come in. See the API
# gateway image for the details.
RUN apk upgrade --no-cache \
 && apk add --no-cache dumb-init \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v* \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/yarn /usr/local/bin/yarnpkg

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# The standalone bundle reproduces the workspace layout below the tracing root,
# so `server.js` sits at the path the app occupies in the monorepo --
# oolix/apps/web-portal/. These three paths and `outputFileTracingRoot` in
# next.config.mjs have to move together. Get one wrong and the image builds
# cleanly, passes a layer inspection, and exits on start with "Cannot find
# module", because the file really is somewhere else.
COPY --from=build --chown=root:root /repo/oolix/apps/web-portal/.next/standalone ./
COPY --from=build --chown=root:root /repo/oolix/apps/web-portal/.next/static ./oolix/apps/web-portal/.next/static

# No `public/` copy: this app has no static asset directory. Adding one later
# means adding it here too, or the files will simply 404.

USER node
EXPOSE 3000

# The login page is the one route that renders without a session, which makes it
# the honest check for "is this serving" — anything authenticated would report a
# redirect and tell us nothing.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "oolix/apps/web-portal/server.js"]
