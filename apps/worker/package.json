{
  "name": "@oolix/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Oolix background worker: queue consumers, aggregation, schedulers (spec v5 \u00a755).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1116.0",
    "@oolix/contracts": "workspace:*",
    "@oolix/manifest-schema": "workspace:*",
    "@oolix/observability": "workspace:*",
    "@oolix/runtime-config": "workspace:*",
    "ioredis": "6.0.0",
    "zod": "4.4.3",
    "@oolix/db": "workspace:*",
    "@prisma/adapter-pg": "7.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
